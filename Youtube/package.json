{
  "name": "youtube-agentic-ai",
  "version": "1.0.0",
  "description": "Agentic AI workflow system for YouTube video production using Genkit and Gemini 3",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "genkit start -- tsx watch src/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:web\"",
    "dev:web": "cd apps/web && npm run dev",
    "build": "tsc",
    "build:all": "npm run build && cd apps/web && npm run build",
    "start": "node dist/index.js",
    "genkit:ui": "genkit start",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose --profile dev-tools up -d",
    "test": "vitest",
    "test:agent": "vitest --reporter=verbose",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live": "LIVE_API=true vitest run",
    "benchmark:quality": "tsx scripts/benchmark-quality.ts",
    "report:cost": "tsx scripts/cost-report.ts",
    "auth:token": "tsx scripts/get-refresh-token.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "setup": "npm install && cd apps/web && npm install",
    "health": "tsx scripts/health-check.ts"
  },
  "keywords": [
    "youtube",
    "ai",
    "genkit",
    "gemini",
    "agentic",
    "video-generation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@genkit-ai/ai": "^1.27.0",
    "@genkit-ai/core": "^1.27.0",
    "@genkit-ai/googleai": "^1.27.0",
    "@genkit-ai/vertexai": "^1.27.0",
    "@google-cloud/text-to-speech": "^5.7.0",
    "@google-cloud/vertexai": "^1.9.0",
    "@google/genai": "^1.35.0",
    "bullmq": "^5.66.4",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^9.14.2",
    "googleapis": "^144.0.0",
    "ioredis": "^5.9.1",
    "pino": "^9.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.16.0",
    "genkit": "^1.27.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
